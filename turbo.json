{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": [
        "TINYTINKERER_DEPLOY_BASE",
        "TINYTINKERER_TEST_REPORT_DIR",
        "GIT_SHA",
        "VITE_EDGE_URL",
        "VITE_SENTRY_DSN",
        "VITE_SENTRY_ENVIRONMENT",
        "SENTRY_AUTH_TOKEN"
      ]
    },
    "@tinytinkerer/brand-assets#generate": {
      "inputs": [
        "$TURBO_ROOT$/LICENSE",
        "$TURBO_ROOT$/apps/**/package.json",
        "$TURBO_ROOT$/config/pixel-agents-third-party.json",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/packages/**/package.json",
        "$TURBO_ROOT$/pnpm-lock.yaml",
        "$TURBO_ROOT$/pnpm-workspace.yaml",
        "$TURBO_ROOT$/scripts/generate-brand-assets.mjs",
        "$TURBO_ROOT$/scripts/generate-notices.mjs",
        "$TURBO_ROOT$/scripts/lib/dependency-licenses.mjs",
        "assets/source/**",
        "package.json"
      ],
      "outputs": [
        "assets/generated/**",
        "src/license.generated.ts",
        "src/third-party-notices.generated.ts"
      ]
    },
    "@tinytinkerer/brand-assets#build": {
      "dependsOn": ["^build", "generate"],
      "outputs": []
    },
    "@tinytinkerer/docs#build": {
      "dependsOn": ["^build", "@tinytinkerer/brand-assets#generate"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/docs/**",
        "$TURBO_ROOT$/config/pixel-agents-upstream.json",
        "$TURBO_ROOT$/config/pixel-agents-third-party.json",
        "$TURBO_ROOT$/scripts/prepare-pixel-agents.mjs",
        "$TURBO_ROOT$/scripts/pixel-agents-bridge.mjs",
        "$TURBO_ROOT$/scripts/pixel-agents-animation-probe.mjs",
        "$TURBO_ROOT$/scripts/build-pixel-agents-assets.mjs",
        "$TURBO_ROOT$/scripts/check-pixel-agents-conformance.mjs"
      ],
      "outputs": ["build/**"],
      "env": ["TINYTINKERER_DEPLOY_BASE"]
    },
    "@tinytinkerer/pixel-agents-shell#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": [
        "TINYTINKERER_DEPLOY_BASE",
        "TINYTINKERER_TEST_REPORT_DIR",
        "GIT_SHA",
        "VITE_EDGE_URL",
        "VITE_SENTRY_DSN",
        "VITE_SENTRY_ENVIRONMENT",
        "SENTRY_AUTH_TOKEN"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/config/pixel-agents-upstream.json",
        "$TURBO_ROOT$/config/pixel-agents-third-party.json",
        "$TURBO_ROOT$/scripts/prepare-pixel-agents.mjs",
        "$TURBO_ROOT$/scripts/pixel-agents-bridge.mjs",
        "$TURBO_ROOT$/scripts/pixel-agents-animation-probe.mjs",
        "$TURBO_ROOT$/scripts/build-pixel-agents-assets.mjs",
        "$TURBO_ROOT$/scripts/check-pixel-agents-conformance.mjs"
      ]
    },
    "@tinytinkerer/host#build": {
      "dependsOn": [
        "@tinytinkerer/docs#build",
        "@tinytinkerer/shell#build",
        "@tinytinkerer/canvas-shell#build",
        "@tinytinkerer/ide-shell#build",
        "@tinytinkerer/mermaid-shell#build",
        "@tinytinkerer/pixel-agents-shell#build"
      ],
      "outputs": ["dist/**", "dist-root/**"],
      "env": [
        "TINYTINKERER_DEPLOY_BASE",
        "TINYTINKERER_TEST_REPORT_DIR",
        "GIT_SHA",
        "VITE_EDGE_URL",
        "VITE_SENTRY_DSN",
        "VITE_SENTRY_ENVIRONMENT",
        "SENTRY_AUTH_TOKEN"
      ]
    },
    "dev": {
      "dependsOn": ["@tinytinkerer/brand-assets#generate"],
      "cache": false,
      "persistent": true,
      "env": [
        "TINYTINKERER_DEPLOY_BASE",
        "TINYTINKERER_DOCS_DEV_ORIGIN",
        "GIT_SHA",
        "VITE_EDGE_URL",
        "VITE_SENTRY_DSN",
        "VITE_SENTRY_ENVIRONMENT",
        "SENTRY_AUTH_TOKEN"
      ]
    },
    "lint": {
      "dependsOn": ["@tinytinkerer/brand-assets#generate"]
    },
    "test": {
      "dependsOn": ["@tinytinkerer/brand-assets#generate"],
      "outputs": ["coverage/**"]
    },
    "typecheck": {
      "dependsOn": ["@tinytinkerer/brand-assets#generate"]
    }
  }
}
