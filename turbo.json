{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "config/pixel-agents-upstream.json",
    "scripts/build-pixel-agents-assets.mjs",
    "scripts/pixel-agents-bridge.mjs",
    "scripts/prepare-pixel-agents.mjs"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": [
        "TINYTINKERER_SKIP_BRAND_ASSET_GENERATION",
        "TINYTINKERER_DEPLOY_BASE",
        "TINYTINKERER_TEST_REPORT_DIR",
        "GIT_SHA",
        "VITE_EDGE_URL",
        "VITE_SENTRY_DSN",
        "VITE_SENTRY_ENVIRONMENT",
        "SENTRY_AUTH_TOKEN"
      ]
    },
    "@tinytinkerer/host#build": {
      "dependsOn": [
        "@tinytinkerer/shell#build",
        "@tinytinkerer/canvas-shell#build",
        "@tinytinkerer/ide-shell#build",
        "@tinytinkerer/mermaid-shell#build",
        "@tinytinkerer/pixel-agents-shell#build"
      ],
      "outputs": ["dist/**", "dist-root/**"],
      "env": [
        "TINYTINKERER_SKIP_BRAND_ASSET_GENERATION",
        "TINYTINKERER_DEPLOY_BASE",
        "TINYTINKERER_TEST_REPORT_DIR",
        "GIT_SHA",
        "VITE_EDGE_URL",
        "VITE_SENTRY_DSN",
        "VITE_SENTRY_ENVIRONMENT",
        "SENTRY_AUTH_TOKEN"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "TINYTINKERER_SKIP_BRAND_ASSET_GENERATION",
        "TINYTINKERER_DEPLOY_BASE",
        "GIT_SHA",
        "VITE_EDGE_URL",
        "VITE_SENTRY_DSN",
        "VITE_SENTRY_ENVIRONMENT",
        "SENTRY_AUTH_TOKEN"
      ]
    },
    "lint": {},
    "test": {
      "outputs": ["coverage/**"]
    },
    "typecheck": {}
  }
}
