{
  "name": "@tinytinkerer/docs",
  "version": "0.1.0",
  "private": true,
  "tinytinkerer": {
    "architectureRole": "integrated-shell",
    "stagePackage": "@tinytinkerer/pixel-agents"
  },
  "scripts": {
    "dev": "pnpm -w prepare:pixel-agents && docusaurus start --host 127.0.0.1 --port 3112 --no-open",
    "start": "docusaurus start",
    "build": "pnpm -w prepare:pixel-agents && docusaurus build",
    "lint": "eslint tests docusaurus.config.ts sidebars.ts site-config.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-mermaid": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "0.55.2",
    "@mdx-js/react": "3.1.1",
    "@mermaid-js/layout-elk": "0.1.9",
    "@tinytinkerer/app-browser": "workspace:*",
    "@tinytinkerer/app-shell": "workspace:*",
    "@tinytinkerer/pixel-agents": "workspace:*",
    "prism-react-renderer": "2.4.1",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/plugin-content-docs": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "25.9.1",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "vite": "8.0.14",
    "vitest": "4.1.7"
  }
}
